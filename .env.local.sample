KINDE_CLIENT_ID=<your_kinde_client_id>
KINDE_CLIENT_SECRET=<your_kinde_client_secret>
KINDE_ISSUER_URL=https://<your_kinde_subdomain>.kinde.com
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000
CONVEX_DEPLOYMENT=<set_by_npx_convex_dev>
NEXT_PUBLIC_CONVEX_URL=<set_by_npx_convex_dev>
NEXT_PUBLIC_CONVEX_SITE_URL=<set_by_npx_convex_dev>
KINDE_AUDIENCE=https://gatehouse.api

# End-to-end check (npm run e2e). Copy the token from /api/session-token while signed in.
E2E_MCP_URL=https://<your_kinde_subdomain>.kinde.com/mcp/<connection_id>
E2E_ACCESS_TOKEN=
